{
	"productName": "StripchatRecorder",
	"version": "0.5.3",
	"identifier": "com.chantrail.stripchat-recorder",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "StripchatRecorder",
				"width": 1600,
				"height": 720,
				"resizable": true,
				"fullscreen": false,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"nsis",
			"app",
			"dmg",
			"appimage",
			"deb"
		],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MDkxRDFBNDMwNDg1QkIKUldTN2hRUkRHaDBKV1AreGlyYUdPQzZWK0J0KzBHeU1aaTZoV3g4ZDhKeVY3bGtDZUxkNlFnSDEK",
			"endpoints": [
				"https://github.com/ChanTrail/StripchatRecorder/releases/latest/download/latest.json"
			]
		}
	}
}
